{
  "name": "qingprocess-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "check:frontend": "npm run build && node scripts/check-frontend.cjs ../src ../frontend/src"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@google/genai": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@electric-sql/pglite": "^0.3.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
