NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://qingprocess:change-me@localhost:5432/qingprocess
# Docker Compose database password; match the password in DATABASE_URL for host tools.
POSTGRES_PASSWORD=
APP_ORIGIN=http://localhost:3000
SESSION_HOURS=8
DB_POOL_SIZE=10
# Configure only the actual reverse-proxy addresses/subnets; never blindly trust all proxies.
TRUST_PROXY=
BOOTSTRAP_USER=admin
# Set a unique password of at least 12 characters before bootstrap.
BOOTSTRAP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# PEM public key; literal \\n sequences are accepted. Signing key is never hosted here.
LICENSE_PUBLIC_KEY=
MACHINE_ID=

# Optional external OpenAI-compatible models: generate a 32-byte Base64 key once and keep it backed up.
MODEL_CONFIG_KEY=
# Exact HTTPS hostname allowlist for configured model providers; redirects are rejected.
AI_ALLOWED_HOSTS=api.openai.com,api.deepseek.com
